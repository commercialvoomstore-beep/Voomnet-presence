# VOOMNET Presence — variables d'environnement
# Copier en .env.local (jamais commité) puis renseigner DATABASE_URL pour passer
# de data/*.json à PostgreSQL / Neon. Sans DATABASE_URL, l'app reste en mode fichier.

# ——— Base de données ———
# Neon → Dashboard > Connection Details > « Pooled connection » (recommandé côté serveur)
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#   sslmode=require est ajouté automatiquement pour un hôte *.neon.tech / *.neon.run
DATABASE_URL=

# TLS : require (défaut pour Neon) | no-verify | disable (PostgreSQL local)
# DB_SSL=require

# Bassin de connexions (PgBouncer côté Neon : garder max modeste, ex. 5-10)
# DATABASE_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_QUERY_TIMEOUT_MS=15000

# ——— Comptes administrateurs ———
# Utilisés à l'amorçage de la base (table admins). En l'absence de ces variables,
# les identifiants de démonstration sont employés : à ne jamais laisser en production.
# VP_ADMIN_SUPER_EMAIL=admin@voomnet.ci
# VP_ADMIN_SUPER_PASSWORD=
# VP_ADMIN_IT_EMAIL=it@voomnet.ci
# VP_ADMIN_IT_PASSWORD=
